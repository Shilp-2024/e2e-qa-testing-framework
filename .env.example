# =============================================================================
# E2E QA TESTING FRAMEWORK — ENVIRONMENT CONFIGURATION
# =============================================================================
# Three environment files are used in this project:
#
#   .env.dev    — development  : day-to-day testing and feature implementation
#   .env.stage  — staging      : full suite after each release to stage
#   .env.prod   — production   : happy path (P1) smoke only, no CRUD operations
#
# To activate an environment, copy the relevant file to .env:
#   cp .env.dev .env      ← default for active development
#   cp .env.stage .env    ← when validating a stage release
#   cp .env.prod .env     ← when running prod smoke after a production release
#
# All three files (.env, .env.dev, .env.stage, .env.prod) are gitignored.
# Each team member must create their own copies with a personal Jira API token.
# =============================================================================


# =============================================================================
# APPLICATION UNDER TEST
# =============================================================================
# The base URL of the application you are testing.
# This is used by playwright.config.ts as the baseURL for all tests.
#
# Examples:
#   BASE_URL=https://staging.yourapp.com
#   BASE_URL=https://dev.yourapp.com
#   BASE_URL=http://localhost:3000
#
BASE_URL=https://your-app.example.com

# The full URL of the sign-in / login page (used in test data and page objects)
SIGN_IN_URL=https://your-app.example.com/sign-in


# =============================================================================
# TEST USER CREDENTIALS
# =============================================================================
# Use a dedicated QA test account — never a real user or production account.
# This account must already exist in your application before running tests.
# TEST_USER_EMAIL is a LOGIN account — it must be a real provisioned user, NOT a
# generated alias.
#
# Test-data emails (form-fill fields the app SENDS mail to) are a separate concern:
# generate them at runtime with generateTestEmail() (shared/utils/testData.ts), which
# produces a unique, deliverable {local}+{DDMMM}{nnn}@{domain} alias of TEST_EMAIL_BASE.
# Never put @yopmail.com / @mailinator.com / @example.com in deliverable fields — bounces
# to dummy domains hurt our Azure Communication Services domain reputation.
#
TEST_USER_EMAIL=qa_user@example.com
TEST_USER_PASSWORD=your_test_password_here

# Base inbox for generated test-data emails (see note above). Must be a REAL,
# monitored inbox — generateTestEmail() produces +aliases of it, and they all
# route back to this address so the mail is deliverable.
TEST_EMAIL_BASE=qa.inbox@yourcompany.com


# =============================================================================
# JIRA CONFIGURATION
# =============================================================================
# These values connect Agent 1 and Agent 5 to your Jira Cloud workspace.
# Jira uses a simple email + API token pair — no OAuth exchange/refresh needed.
#
# ── API TOKEN (individual per team member — never share these) ────────────────
# Each team member generates their own token at
# https://id.atlassian.com/manage-profile/security/api-tokens
#
# Steps:
#   1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
#   2. Click "Create API token" → give it a label (e.g. "e2e-qa-framework") → Create
#   3. Copy the token immediately — you only get it once.
#
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your_api_token_here

# ── JIRA_BASE_URL ───────────────────────────────────────────────────────────
# Your Jira Cloud site root, no trailing slash.
#   Example: https://yourcompany.atlassian.net
#
JIRA_BASE_URL=https://yourcompany.atlassian.net

# ── JIRA_PROJECT_KEY ──────────────────────────────────────────────────────────
# How to get it:
#   1. Open the project where features are tracked / bug issues should be created
#   2. Look at any issue key in that project, e.g. WAP-123 → the project key is "WAP"
#
JIRA_PROJECT_KEY=WAP

# The display name of your Jira project (used in reports only — not an API field)
JIRA_PROJECT_NAME=your_project_name_here

# Set to true when running in a CI pipeline (GitHub Actions, Azure DevOps, etc.)
# This disables parallel workers and enables retries automatically in playwright.config.ts
CI=false
