# =============================================================================
# E2E QA TESTING FRAMEWORK — ENVIRONMENT CONFIGURATION
# =============================================================================
# Three environment files are used in this project:
#
#   .env.dev    — development  : day-to-day testing and feature implementation
#   .env.stage  — staging      : full suite after each release to stage
#   .env.prod   — production   : happy path (P1) smoke only, no CRUD operations
#
# To activate an environment, copy the relevant file to .env:
#   cp .env.dev .env      ← default for active development
#   cp .env.stage .env    ← when validating a stage release
#   cp .env.prod .env     ← when running prod smoke after a production release
#
# All three files (.env, .env.dev, .env.stage, .env.prod) are gitignored.
# Each team member must create their own copies with personal Zoho OAuth credentials.
# =============================================================================


# =============================================================================
# APPLICATION UNDER TEST
# =============================================================================
# The base URL of the application you are testing.
# This is used by playwright.config.ts as the baseURL for all tests.
#
# Examples:
#   BASE_URL=https://staging.yourapp.com
#   BASE_URL=https://dev.yourapp.com
#   BASE_URL=http://localhost:3000
#
BASE_URL=https://your-app.example.com

# The full URL of the sign-in / login page (used in test data and page objects)
SIGN_IN_URL=https://your-app.example.com/sign-in


# =============================================================================
# TEST USER CREDENTIALS
# =============================================================================
# Use a dedicated QA test account — never a real user or production account.
# This account must already exist in your application before running tests.
# TEST_USER_EMAIL is a LOGIN account — it must be a real provisioned user, NOT a
# generated alias.
#
# Test-data emails (form-fill fields the app SENDS mail to) are a separate concern:
# generate them at runtime with generateTestEmail() (shared/utils/testData.ts), which
# produces a unique, deliverable {local}+{DDMMM}{nnn}@{domain} alias of TEST_EMAIL_BASE.
# Never put @yopmail.com / @mailinator.com / @example.com in deliverable fields — bounces
# to dummy domains hurt our Azure Communication Services domain reputation.
#
TEST_USER_EMAIL=qa_user@example.com
TEST_USER_PASSWORD=your_test_password_here

# Base inbox for generated test-data emails (see note above). Must be a REAL,
# monitored inbox — generateTestEmail() produces +aliases of it, and they all
# route back to this address so the mail is deliverable.
TEST_EMAIL_BASE=qa.inbox@yourcompany.com


# =============================================================================
# ZOHO PROJECTS CONFIGURATION
# =============================================================================
# These values connect Agent 1 and Agent 5 to your Zoho Projects workspace.
# All values are available inside your Zoho Projects account — no coding needed.
#
# ── OAUTH CREDENTIALS (individual per team member — never share these) ────────
# Each team member generates their own credentials at https://api-console.zoho.com
#
# Steps:
#   1. Go to https://api-console.zoho.com → Add Client → Self Client → Create
#   2. Click "Generate Code" tab, paste scopes:
#      ZohoProjects.portals.ALL,ZohoProjects.projects.ALL,ZohoProjects.tasks.ALL,ZohoProjects.bugs.ALL,ZohoProjects.timesheets.ALL,ZohoProjects.milestones.ALL,ZohoProjects.users.ALL,ZohoProjects.bugs.ALL

#   3. Set duration to 10 minutes → click Create → copy the code
#   4. Run in terminal to exchange for tokens:
#      -------------------------------------------------------------------------
#      curl -X POST "https://accounts.zoho.com/oauth/v2/token" \
#        -d "grant_type=authorization_code" \
#        -d "client_id=YOUR_CLIENT_ID" \
#        -d "client_secret=YOUR_CLIENT_SECRET" \
#        -d "redirect_uri=https://localhost" \
#        -d "code=YOUR_GRANT_CODE"
#      -------------------------------------------------------------------------
#   5. Copy the refresh_token from the response — save it, you only get it once.
#
ZOHO_CLIENT_ID=1000.your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=1000.your_refresh_token_here

# Legacy bearer token — only needed if NOT using OAuth above
# ZOHO_API_KEY=your_bearer_token_here

# ── ZOHO_PORTAL_ID ───────────────────────────────────────────────────────────
# How to get it:
#   1. Log in to Zoho Projects
#   2. Open any project in your portal
#   3. Look at the URL: https://projects.zoho.com/portal/{portal-slug}/...
#   4. Go to: Portal Settings → General → the numeric Portal ID is shown there
#      OR ask your Zoho admin for the portal ID
#   Example: 36485097
#
ZOHO_PORTAL_ID=36485097 #Portal ID will be same for all projects within the same portal, so you can use any project to find it

# ── ZOHO_PROJECT_ID ──────────────────────────────────────────────────────────
# How to get it:
#   1. Open the specific project where bug issues should be created
#   2. Look at the URL: https://projects.zoho.com/portal/{slug}/#zp/projects/{PROJECT_ID}/...
#   3. The long numeric ID in the URL is your project ID
#   Example: 688906000001071159
#
ZOHO_PROJECT_ID=your_project_id_here

# The display name of your Zoho project (used in reports only — not an API field)
ZOHO_PROJECT_NAME=your_project_name_here

# Zoho Projects REST API base URL — do not change this unless Zoho changes it
ZOHO_BASE_URL=https://projectsapi.zoho.com/restapi

# =============================================================================
# MOBILE (APPIUM) PIPELINE — only needed if running agents/mobile/*
# =============================================================================
# Appium server (started automatically by @wdio/appium-service unless you point
# this at an already-running server, e.g. a remote/cloud Appium instance).
APPIUM_SERVER_URL=http://localhost:4723

# ── Android ───────────────────────────────────────────────────────────────
# ANDROID_APK_PATH takes priority (installs fresh); if unset, ANDROID_APP_PACKAGE
# + ANDROID_APP_ACTIVITY are used against an already-installed app.
ANDROID_APK_PATH=./builds/app-debug.apk
ANDROID_APP_PACKAGE=com.yourcompany.yourapp
ANDROID_APP_ACTIVITY=.MainActivity
ANDROID_DEVICE_NAME=Pixel_7_API_34
ANDROID_PLATFORM_VERSION=14

# ── iOS ───────────────────────────────────────────────────────────────────
# IOS_APP_PATH (.app bundle) is for SIMULATORS only. IOS_IPA_PATH (signed .ipa)
# is for REAL DEVICES only — they are not interchangeable. IOS_BUNDLE_ID is used
# instead of either path if the app is already installed. IOS_UDID is required
# for real devices, optional for simulators (falls back to IOS_DEVICE_NAME).
IOS_APP_PATH=./builds/YourApp.app
IOS_IPA_PATH=./builds/YourApp.ipa
IOS_BUNDLE_ID=com.yourcompany.yourapp
IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=17.5
IOS_UDID=

# Set to true when running in a CI pipeline (GitHub Actions, Azure DevOps, etc.)
# This disables parallel workers and enables retries automatically in playwright.config.ts
CI=false
