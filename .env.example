# =============================================================================
# E2E QA TESTING FRAMEWORK — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
#
# Usage:
#   cp .env.example .env
#   Then fill in the values below.
# =============================================================================


# =============================================================================
# APPLICATION UNDER TEST
# =============================================================================
# The base URL of the application you are testing.
# This is used by playwright.config.ts as the baseURL for all tests.
#
# Examples:
#   BASE_URL=https://staging.yourapp.com
#   BASE_URL=https://dev.yourapp.com
#   BASE_URL=http://localhost:3000
#
BASE_URL=https://your-app.example.com

# The full URL of the sign-in / login page (used in test data and page objects)
SIGN_IN_URL=https://your-app.example.com/sign-in

NODE_ENV=development


# =============================================================================
# TEST USER CREDENTIALS
# =============================================================================
# Use a dedicated QA test account — never a real user or production account.
# This account must already exist in your application before running tests.
#
TEST_USER_EMAIL=qa_user@example.com
TEST_USER_PASSWORD=your_test_password_here


# =============================================================================
# ZOHO PROJECTS CONFIGURATION
# =============================================================================
# These values connect Agent 1 and Agent 5 to your Zoho Projects workspace.
# All values are available inside your Zoho Projects account — no coding needed.
#
# ── ZOHO_API_KEY ─────────────────────────────────────────────────────────────
# How to get it:
#   1. Log in to Zoho Projects
#   2. Click your profile avatar (top-right) → Developer Space → OAuth
#      OR go to: https://accounts.zoho.com/developerconsole
#   3. Create a "Self Client" → generate a token with scope:
#      ZohoProjects.portals.READ, ZohoProjects.projects.READ,
#      ZohoProjects.tasks.READ, ZohoProjects.bugs.CREATE, ZohoProjects.bugs.READ
#   4. Copy the generated Bearer token here
#
ZOHO_API_KEY=your_bearer_token_here # This is not required if MCP is already generating the token and setting it in config.json, but you can override it here if needed

# ── ZOHO_PORTAL_ID ───────────────────────────────────────────────────────────
# How to get it:
#   1. Log in to Zoho Projects
#   2. Open any project in your portal
#   3. Look at the URL: https://projects.zoho.com/portal/{portal-slug}/...
#   4. Go to: Portal Settings → General → the numeric Portal ID is shown there
#      OR ask your Zoho admin for the portal ID
#   Example: 36485097
#
ZOHO_PORTAL_ID=36485097 #Portal ID will be same for all projects within the same portal, so you can use any project to find it

# ── ZOHO_PROJECT_ID ──────────────────────────────────────────────────────────
# How to get it:
#   1. Open the specific project where bug issues should be created
#   2. Look at the URL: https://projects.zoho.com/portal/{slug}/#zp/projects/{PROJECT_ID}/...
#   3. The long numeric ID in the URL is your project ID
#   Example: 688906000001071159
#
ZOHO_PROJECT_ID=your_project_id_here

# The display name of your Zoho project (used in reports only — not an API field)
ZOHO_PROJECT_NAME=your_project_name_here

# Zoho Projects REST API base URL — do not change this unless Zoho changes it
ZOHO_BASE_URL=https://projectsapi.zoho.com/restapi


# =============================================================================
# FILE PATHS (do not change unless you restructure the project)
# =============================================================================
BUG_REPORTS_PATH=./features
ATTACHMENTS_PATH=./reports/test-results
CONFIG_PATH=./zoho/config.json


# =============================================================================
# LOGGING AND CI
# =============================================================================
LOG_LEVEL=info
LOG_PATH=./logs

# Set to true when running in a CI pipeline (GitHub Actions, Azure DevOps, etc.)
# This disables parallel workers and enables retries automatically in playwright.config.ts
CI=false
