{
  "name": "e2e-qa-testing-framework",
  "version": "1.0.0",
  "description": "Playwright-based E2E QA framework with a 5-agent pipeline: Feature Analysis, Codegen, Test Generation, Bug Reporting, and Zoho Integration",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright test; npx playwright show-report reports/playwright-report",
    "show-report": "npx playwright show-report reports/playwright-report",
    "merge-report": "npx playwright merge-reports --reporter html --reporter-option outputFolder=reports/playwright-report reports/blob-report",
    "test:feature": "playwright test --testPathPattern=features/",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:regression": "playwright test --grep @regression --project=chromium",
    "test:functional": "playwright test --grep @functional --project=chromium",
    "test:security": "playwright test --grep @security --project=chromium",
    "extract-locators": "node scripts/auto_locator_extractor.js",
    "setup": "npm install && npm run create-env && npm run playwright-install",
    "create-env": "cp .env.example .env",
    "playwright-install": "playwright install",
    "clean": "rm -rf reports/test-results/* reports/playwright-report/* reports/blob-report/*",
    "lint": "eslint .",
    "format": "prettier --write .",
    "mobile:test": "wdio run ./wdio.conf.ts",
    "mobile:test:smoke": "wdio run ./wdio.conf.ts --mochaOpts.grep @smoke",
    "mobile:test:regression": "wdio run ./wdio.conf.ts --mochaOpts.grep @regression",
    "mobile:test:functional": "wdio run ./wdio.conf.ts --mochaOpts.grep @functional",
    "mobile:extract-locators": "node scripts/mobile/auto_element_extractor.js",
    "mobile:appium-doctor": "npx appium driver doctor uiautomator2 && npx appium driver doctor xcuitest",
    "mobile:clean": "rm -rf reports/mobile/test-results/* reports/mobile/screenshots/*"
  },
  "keywords": [
    "e2e",
    "qa",
    "testing",
    "playwright",
    "appium",
    "webdriverio",
    "mobile",
    "automation",
    "zoho",
    "agents"
  ],
  "author": "QA Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/json-reporter": "^9.0.0",
    "@wdio/junit-reporter": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.0.0",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0"
  },
  "dependencies": {
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "appium-xcuitest-driver": "^7.24.0",
    "webdriverio": "^9.0.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "marked": "^11.0.0",
    "gray-matter": "^4.0.3"
  }
}
